[Unit]
Description=HavnVard INFRA-126 Tier E critical-path verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=havnvard
WorkingDirectory=/opt/havnvard/infra126
EnvironmentFile=/etc/havnvard/infra126.env
ExecStart=/opt/havnvard/infra126/.venv/bin/python scripts/run_scheduled_tier.py --tier E --max-items 25000
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=havnvard-infra126-e
