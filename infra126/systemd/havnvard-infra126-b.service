[Unit]
Description=HavnVard INFRA-126 Tier B verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=havnvard
WorkingDirectory=/opt/havnvard/infra126
EnvironmentFile=/etc/havnvard/infra126.env
ExecStart=/opt/havnvard/infra126/.venv/bin/python scripts/run_scheduled_tier.py --tier B --max-items 500000
Nice=17
IOSchedulingClass=idle
TimeoutStartSec=12h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=havnvard-infra126-b
