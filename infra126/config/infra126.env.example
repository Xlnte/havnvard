POSTGRES_URL=postgresql://ROLE:PASSWORD@127.0.0.1:5432/havnvard
INFRA126_BATCH_SIZE=500
INFRA126_ENQUEUE_PAGE_SIZE=5000
INFRA126_LEASE_SECONDS=1800
INFRA126_HEARTBEAT_SECONDS=30
INFRA126_HASH_TIMEOUT_SECONDS=1200
INFRA126_REMOTE_BATCH_TIMEOUT_SECONDS=1200
INFRA126_REMOTE_POLL_SECONDS=15
INFRA126_REMOTE_HEARTBEAT_STALE_SECONDS=300
INFRA126_AUTO_ACCEPT_MUTABLE_SCORE=90
INFRA126_STABILIZATION_DELAY_HOURS=24
INFRA126_LOG_DIR=/var/log/havnvard/infra126

# INFRA-281 path-exclusion policy. Paths listed here are NEVER enqueued for
# verification, are reported per-prefix in the journal and on the run row
# (config_json.path_exclusions), and are counted separately from read failures
# so they cannot make a run fail. Entries are "[host:]/absolute/prefix/" (comma
# or newline separated), or a JSON array of {"host","prefix","reason"} objects.
# Unset or empty = no exclusions. Example: a home folder the verifier's user cannot read.
# INFRA126_EXCLUDE_PATH_PREFIXES=server-1:/home/olduser/

# Commands consume one JSON document on stdin and must return zero only after
# delivery succeeds. Leave unset only in isolated test mode.
# TG = an alert sink, PLANE = a ticket sink, WAITINGROOM = an optional admission gate (e.g. a GPU/IO scheduler).
INFRA126_TG_COMMAND=/usr/local/bin/havnvard-alert-json
INFRA126_PLANE_COMMAND=/usr/local/bin/havnvard-ticket-json
# INFRA126_WAITINGROOM_ACQUIRE_COMMAND=/usr/local/bin/waitingroom-acquire
# INFRA126_WAITINGROOM_RELEASE_COMMAND=/usr/local/bin/waitingroom-release
INFRA126_WAITINGROOM_MAX_WAIT_SECONDS=1800
INFRA126_WAITINGROOM_RETRY_SECONDS=30

# Hosts to verify. Unset = only this machine. Never point a NAS scratch dir at /tmp (tmpfs on QNAP).
# Hosts without "auth" default to "auth":"pubkey" (plain key-based ssh).
# "auth":"sshpass" requires "credentials_file" (root-owned, NAS_USER/NAS_HOST/NAS_PASS);
# for those hosts the credentials file -- not ssh_target -- decides user@host.
# INFRA126_HOSTS_JSON={"server-1":{"mode":"local"},"nas-1":{"mode":"remote","ssh_target":"backup@nas-1.example","scratch_dir":"/share/CACHEDEV1_DATA/.diskaudit_scratch/infra126","auth":"sshpass","credentials_file":"/etc/havnvard/nas_backup.env"},"agent-1":{"mode":"remote","ssh_target":"havnvard@agent-1.example","scratch_dir":"/var/lib/havnvard/infra126"}}

# Safety escape hatch for isolated development only. Production must remain 0.
INFRA126_ALLOW_NULL_INTEGRATIONS=0
