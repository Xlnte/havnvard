# HavnVard (formerly diskaudit) — required/optional environment variables.
# Copy real values to /etc/forge/tokens/ — NEVER commit a real .env in this repo.
# See config/env.example convention: /home/parker/claude-code-inbox/INFRA-82_directory_standard.md

# ── Required ──────────────────────────────────────────────────────────────────
# Postgres connection (schema `diskaudit` in database `ultra_crm`).
# SoT: /srv/forge/.secrets/prod/diskaudit.env — scan.py/monitor.py/etc. fall back to reading
# that file directly if POSTGRES_URL isn't in the environment already.
POSTGRES_URL=postgresql://ultra_crm@127.0.0.1:5432/ultra_crm

# ── NAS crawl (load_nas_inventory.py, nas_native_crawl.sh) ────────────────────
# Real values: /etc/forge/tokens/nas_backup.env + nas_backup.pass (chmod 600).
NAS_USER=sparkbkup
NAS_HOST=nas-ts453a
NAS_PATH=/share/bkup_spark
# sshpass -f <path-to-pass-file>, never -p with an inline value (cleartext in `ps`).

# ── Restic backup wrapper scripts (backup_heartbeat_cli.py callers) ───────────
# Real values: /etc/forge/tokens/havnvard_restic.env + restic_backup.pass (chmod 600).
RESTIC_PASSWORD_FILE=/etc/forge/tokens/restic_backup.pass
# RESTIC_REPO_<TARGET>= one line per backup target, appended as targets are added.

# ── Optional ────────────────────────────────────────────────────────────────
# TG PRESIDENT alerting (monitor.py). SoT: /srv/forge/.secrets/prod/diskaudit.env.
AGENT_BOT_TOKEN=
TG_PRESIDENT_CHAT=-1003801720077
