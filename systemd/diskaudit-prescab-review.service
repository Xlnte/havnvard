[Unit]
Description=diskaudit — weekly PRESCAB operational review
Documentation=file:///home/parker/runbooks/20260718-diskaudit-prescab-weekly-review/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/diskaudit
ExecStart=/srv/diskaudit/.venv/bin/python /srv/diskaudit/weekly_prescab_review.py
StandardOutput=journal
StandardError=journal
Nice=10
TimeoutStartSec=5min
