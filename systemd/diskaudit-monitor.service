[Unit]
Description=diskaudit — stale/failed run monitor (TG PRESI alerting)
Documentation=file:///home/parker/runbooks/20260717-diskaudit-v2-heartbeat-monitor/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/diskaudit
ExecStart=/srv/diskaudit/.venv/bin/python /srv/diskaudit/monitor.py
StandardOutput=journal
StandardError=journal
Nice=10
TimeoutStartSec=5min
