[Unit]
Description=diskaudit — load-bearing path refresh (classification layer v1)
Documentation=file:///home/parker/runbooks/20260718-diskaudit-classification/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/diskaudit
ExecStart=/srv/diskaudit/.venv/bin/python /srv/diskaudit/refresh_load_bearing_paths.py
StandardOutput=journal
StandardError=journal
Nice=10
TimeoutStartSec=30min
